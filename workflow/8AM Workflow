      "parameters": {
        "jsCode": "// =============================================================\n// CRYPTO PORTFOLIO PROCESSOR\n// Takes merged price+holdings data and calculates portfolio metrics\n// =============================================================\n\nconst items = $input.all();\nconst portfolio = [];\nlet totalCurrentValue = 0;\nlet totalInvestedValue = 0;\n\n// Process each coin\nfor (const item of items) {\n  const data = item.json;\n  \n  // Parse numbers (Google Sheets sometimes returns strings)\n  const holdings = parseFloat(data.holdings) || 0;\n  const buyPrice = parseFloat(data.buy_price_usd) || 0;\n  const currentPrice = parseFloat(data.current_price) || 0;\n  const change24h = parseFloat(data.price_change_percentage_24h) || 0;\n  const change7d = parseFloat(data.price_change_percentage_7d_in_currency) || 0;\n  const marketCap = parseFloat(data.market_cap) || 0;\n  const volume24h = parseFloat(data.total_volume) || 0;\n  \n  // Calculate position values\n  const currentValue = holdings * currentPrice;\n  const investedValue = holdings * buyPrice;\n  const profitLoss = currentValue - investedValue;\n  const profitLossPercent = investedValue > 0 \n    ? ((currentValue - investedValue) / investedValue) * 100 \n    : 0;\n  \n  totalCurrentValue += currentValue;\n  totalInvestedValue += investedValue;\n  \n  portfolio.push({\n    symbol: data.symbol ? data.symbol.toUpperCase() : 'N/A',\n    name: data.name || 'Unknown',\n    holdings: holdings,\n    buyPrice: buyPrice,\n    currentPrice: currentPrice,\n    currentValue: currentValue,\n    investedValue: investedValue,\n    profitLoss: profitLoss,\n    profitLossPercent: profitLossPercent,\n    change24h: change24h,\n    change7d: change7d,\n    marketCap: marketCap,\n    volume24h: volume24h,\n    // Flag coins with >5% 24h move\n    isAlert: Math.abs(change24h) > 5\n  });\n}\n\n// Calculate allocation percentages\nfor (const coin of portfolio) {\n  coin.allocationPercent = totalCurrentValue > 0 \n    ? (coin.currentValue / totalCurrentValue) * 100 \n    : 0;\n}\n\n// Sort by current value (largest position first)\nportfolio.sort((a, b) => b.currentValue - a.currentValue);\n\n// Find the biggest movers (24h)\nconst biggestGainer = [...portfolio].sort((a, b) => b.change24h - a.change24h)[0];\nconst biggestLoser = [...portfolio].sort((a, b) => a.change24h - b.change24h)[0];\n\n// Count alerts\nconst alertCoins = portfolio.filter(c => c.isAlert);\n\n// Build the summary object\nconst summary = {\n  totalCurrentValue: totalCurrentValue,\n  totalInvestedValue: totalInvestedValue,\n  totalProfitLoss: totalCurrentValue - totalInvestedValue,\n  totalProfitLossPercent: totalInvestedValue > 0 \n    ? ((totalCurrentValue - totalInvestedValue) / totalInvestedValue) * 100 \n    : 0,\n  coinCount: portfolio.length,\n  alertCount: alertCoins.length,\n  alertCoins: alertCoins.map(c => c.symbol),\n  biggestGainer: biggestGainer ? { symbol: biggestGainer.symbol, change: biggestGainer.change24h } : null,\n  biggestLoser: biggestLoser ? { symbol: biggestLoser.symbol, change: biggestLoser.change24h } : null,\n  timestamp: new Date().toISOString()\n};\n\n// Return a single item with all portfolio data\nreturn [{\n  json: {\n    portfolioSummary: summary,\n    portfolioPositions: portfolio\n  }\n}];"
