      "parameters": {
        "jsCode": "// =============================================================\n// BUSINESS KPI PROCESSOR\n// Reads all weekly KPI rows, calculates trends, moving averages,\n// and flags anomalies (>2 standard deviations from recent trend)\n// =============================================================\n\nconst items = $input.all();\nconst rows = items.map(item => item.json);\n\n// Sort by date ascending (oldest first)\nrows.sort((a, b) => new Date(a.week_ending) - new Date(b.week_ending));\n\n// --- Helper functions ---\n\n// Calculate mean of an array of numbers\nfunction mean(arr) {\n  if (arr.length === 0) return 0;\n  return arr.reduce((sum, val) => sum + val, 0) / arr.length;\n}\n\n// Calculate standard deviation\nfunction stdDev(arr) {\n  if (arr.length < 2) return 0;\n  const avg = mean(arr);\n  const squareDiffs = arr.map(val => Math.pow(val - avg, 2));\n  return Math.sqrt(mean(squareDiffs));\n}\n\n// Calculate a simple moving average over the last N values\nfunction movingAverage(arr, windowSize) {\n  if (arr.length < windowSize) return mean(arr);\n  const window = arr.slice(-windowSize);\n  return mean(window);\n}\n\n// --- Get the most recent rows for analysis ---\nconst recentWeeks = 8; // Look at last 8 weeks for trend\nconst recent = rows.slice(-recentWeeks);\nconst latest = rows[rows.length - 1];\nconst previous = rows.length >= 2 ? rows[rows.length - 2] : null;\n\n// --- KPI metrics to track ---\nconst metrics = [\n  'weekly_revenue', 'weekly_costs', 'profit_margin', 'mrr',\n  'churn_rate', 'customer_count', 'new_customers',\n  'support_tickets', 'avg_ticket_resolution_hrs', 'cash_runway_months'\n];\n\n// --- Calculate trends and anomalies for each metric ---\nconst kpiAnalysis = {};\nconst anomalies = [];\n\nfor (const metric of metrics) {\n  const allValues = rows.map(r => parseFloat(r[metric]) || 0);\n  const recentValues = recent.map(r => parseFloat(r[metric]) || 0);\n  const currentVal = parseFloat(latest[metric]) || 0;\n  const previousVal = previous ? (parseFloat(previous[metric]) || 0) : currentVal;\n  \n  // Week-over-week change\n  const wowChange = previousVal !== 0 \n    ? ((currentVal - previousVal) / Math.abs(previousVal)) * 100 \n    : 0;\n  \n  // 4-week and 8-week moving averages\n  const ma4 = movingAverage(allValues, 4);\n  const ma8 = movingAverage(allValues, 8);\n  \n  // Anomaly detection: is current value >2 std devs from recent mean?\n  const recentMean = mean(recentValues);\n  const recentStdDev = stdDev(recentValues);\n  const zScore = recentStdDev > 0 \n    ? (currentVal - recentMean) / recentStdDev \n    : 0;\n  const isAnomaly = Math.abs(zScore) > 2;\n  \n  // Determine trend direction based on last 4 weeks\n  const last4 = allValues.slice(-4);\n  let trend = 'stable';\n  if (last4.length >= 4) {\n    const firstHalf = mean(last4.slice(0, 2));\n    const secondHalf = mean(last4.slice(2, 4));\n    const trendChange = firstHalf !== 0 \n      ? ((secondHalf - firstHalf) / Math.abs(firstHalf)) * 100 \n      : 0;\n    if (trendChange > 2) trend = 'up';\n    else if (trendChange < -2) trend = 'down';\n  }\n  \n  kpiAnalysis[metric] = {\n    current: currentVal,\n    previous: previousVal,\n    wowChange: Math.round(wowChange * 100) / 100,\n    ma4: Math.round(ma4 * 100) / 100,\n    ma8: Math.round(ma8 * 100) / 100,\n    trend: trend,\n    zScore: Math.round(zScore * 100) / 100,\n    isAnomaly: isAnomaly\n  };\n  \n  if (isAnomaly) {\n    anomalies.push({\n      metric: metric,\n      currentValue: currentVal,\n      expectedRange: `${(recentMean - 2 * recentStdDev).toFixed(2)} — ${(recentMean + 2 * recentStdDev).toFixed(2)}`,\n      zScore: Math.round(zScore * 100) / 100,\n      direction: zScore > 0 ? 'above expected' : 'below expected'\n    });\n  }\n}\n\n// --- Build summary ---\nconst businessSummary = {\n  latestWeek: latest.week_ending,\n  previousWeek: previous ? previous.week_ending : null,\n  totalWeeksOfData: rows.length,\n  revenue: kpiAnalysis.weekly_revenue,\n  costs: kpiAnalysis.weekly_costs,\n  profitMargin: kpiAnalysis.profit_margin,\n  mrr: kpiAnalysis.mrr,\n  churnRate: kpiAnalysis.churn_rate,\n  customerCount: kpiAnalysis.customer_count,\n  newCustomers: kpiAnalysis.new_customers,\n  supportTickets: kpiAnalysis.support_tickets,\n  avgResolutionHrs: kpiAnalysis.avg_ticket_resolution_hrs,\n  cashRunway: kpiAnalysis.cash_runway_months,\n  anomalyCount: anomalies.length,\n  anomalies: anomalies,\n  timestamp: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    businessSummary: businessSummary,\n    kpiDetails: kpiAnalysis\n  }\n}];"
