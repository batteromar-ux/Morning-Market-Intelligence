        "jsCode": "// =============================================================\n// HTML EMAIL BUILDER — Morning Market Intelligence\n// Dark fintech theme with gradient accents\n// FIXED: All text now has explicit color so it's readable on dark bg\n// =============================================================\n \nconst items = $input.all();\nconst data = items[0].json;\n \n// The AI analysis text comes from the LLM Chain output\nconst aiAnalysis = data.text || data.response || 'AI analysis unavailable.';\n \n// We need the merged data too — access from earlier node\nlet portfolioSummary, portfolioPositions, businessSummary, kpiDetails;\n \ntry {\n  const mergedData = $('Merge All Data').first().json;\n  portfolioSummary = mergedData.portfolioSummary;\n  portfolioPositions = mergedData.portfolioPositions;\n  businessSummary = mergedData.businessSummary;\n  kpiDetails = mergedData.kpiDetails;\n} catch (e) {\n  portfolioSummary = data.portfolioSummary || {};\n  portfolioPositions = data.portfolioPositions || [];\n  businessSummary = data.businessSummary || {};\n  kpiDetails = data.kpiDetails || {};\n}\n \n// --- Formatting helpers ---\nfunction formatUSD(num) {\n  if (num === undefined || num === null || isNaN(num)) return '$0.00';\n  return '$' + Number(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n}\n \nfunction formatPercent(num) {\n  if (num === undefined || num === null || isNaN(num)) return '0.00%';\n  return Number(num).toFixed(2) + '%';\n}\n \nfunction formatNumber(num) {\n  if (num === undefined || num === null || isNaN(num)) return '0';\n  return Number(num).toLocaleString('en-US');\n}\n \nfunction getChangeColor(val) {\n  if (val > 0) return '#00E676';\n  if (val < 0) return '#FF5252';\n  return '#B0BEC5';\n}\n \nfunction getChangeArrow(val) {\n  if (val > 0) return '▲';\n  if (val < 0) return '▼';\n  return '—';\n}\n \nfunction getTrendIcon(trend) {\n  if (trend === 'up') return '📈';\n  if (trend === 'down') return '📉';\n  return '➡️';\n}\n \n// --- Build crypto positions table rows ---\nlet cryptoRows = '';\nif (portfolioPositions && portfolioPositions.length > 0) {\n  for (const coin of portfolioPositions) {\n    const changeColor = getChangeColor(coin.change24h);\n    const plColor = getChangeColor(coin.profitLoss);\n    const alertBadge = coin.isAlert \n      ? '<span style=\"background:#FF5252;color:#fff;padding:2px 6px;border-radius:3px;font-size:10px;margin-left:4px;\">ALERT</span>' \n      : '';\n    \n    cryptoRows += `\n      <tr style=\"border-bottom:1px solid #2a2f3a;\">\n        <td style=\"padding:10px 12px;color:#E0E0E0;font-weight:600;\">${coin.symbol}${alertBadge}<br><span style=\"font-size:11px;color:#78909C;font-weight:400;\">${coin.name}</span></td>\n        <td style=\"padding:10px 12px;color:#E0E0E0;text-align:right;\">${formatUSD(coin.currentPrice)}</td>\n        <td style=\"padding:10px 12px;text-align:right;color:${changeColor};font-weight:600;\">${getChangeArrow(coin.change24h)} ${formatPercent(coin.change24h)}</td>\n        <td style=\"padding:10px 12px;color:#E0E0E0;text-align:right;\">${coin.holdings}</td>\n        <td style=\"padding:10px 12px;color:#E0E0E0;text-align:right;\">${formatUSD(coin.currentValue)}</td>\n        <td style=\"padding:10px 12px;text-align:right;color:${plColor};font-weight:600;\">${formatUSD(coin.profitLoss)}<br><span style=\"font-size:11px;\">${formatPercent(coin.profitLossPercent)}</span></td>\n        <td style=\"padding:10px 12px;color:#E0E0E0;text-align:right;\">${formatPercent(coin.allocationPercent)}</td>\n      </tr>\n    `;\n  }\n}\n \n// --- Build business KPI cards ---\nfunction kpiCard(title, current, unit, wowChange, trend, isAnomaly) {\n  const changeColor = getChangeColor(wowChange);\n  const anomalyBorder = isAnomaly ? 'border:1px solid #FF5252;' : 'border:1px solid #2a2f3a;';\n  const anomalyBadge = isAnomaly ? '<div style=\"background:#FF5252;color:#fff;padding:2px 6px;border-radius:3px;font-size:9px;margin-top:4px;display:inline-block;\">ANOMALY</div>' : '';\n  \n  let displayValue;\n  if (unit === '$') displayValue = formatUSD(current);\n  else if (unit === '%') displayValue = formatPercent(current * 100);\n  else if (unit === 'pct') displayValue = formatPercent(current);\n  else displayValue = formatNumber(current);\n  \n  return `\n    <td style=\"padding:8px;\">\n      <div style=\"background:#1a1f2e;${anomalyBorder}border-radius:8px;padding:14px;text-align:center;min-width:120px;\">\n        <div style=\"color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;\">${title}</div>\n        <div style=\"color:#E0E0E0;font-size:20px;font-weight:700;\">${displayValue}</div>\n        <div style=\"color:${changeColor};font-size:12px;margin-top:4px;\">${getChangeArrow(wowChange)} ${formatPercent(wowChange)} WoW</div>\n        <div style=\"color:#CFD8DC;font-size:12px;margin-top:2px;\">${getTrendIcon(trend)} ${trend}</div>\n        ${anomalyBadge}\n      </div>\n    </td>\n  `;\n}\n \n// --- Format AI analysis for HTML ---\n// FIX: every paragraph gets explicit color so text is visible on dark background\nlet formattedAnalysis = aiAnalysis\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\n\\n/g, '</p><p style=\"margin:12px 0;line-height:1.6;color:#CFD8DC;font-size:13px;\">')\n  .replace(/\\n/g, '<br>')\n  .replace(/([A-Z][A-Z\\s]{3,}[A-Z])/g, '<strong style=\"color:#64B5F6;font-size:14px;\">$1</strong>');\n \n// --- Assemble the full HTML email ---\nconst reportDate = new Date().toLocaleDateString('en-US', { \n  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' \n});\n \nconst totalPL = portfolioSummary.totalProfitLoss || 0;\nconst totalPLColor = getChangeColor(totalPL);\nconst totalPLPercent = portfolioSummary.totalProfitLossPercent || 0;\n \nconst rev = businessSummary.revenue || {};\nconst margin = businessSummary.profitMargin || {};\nconst mrr = businessSummary.mrr || {};\nconst churn = businessSummary.churnRate || {};\nconst customers = businessSummary.customerCount || {};\nconst runway = businessSummary.cashRunway || {};\nconst tickets = businessSummary.supportTickets || {};\nconst resolution = businessSummary.avgResolutionHrs || {};\n \nconst html = `\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></head>\n<body style=\"margin:0;padding:0;background-color:#0d1117;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#CFD8DC;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#0d1117;padding:20px 0;\">\n<tr><td align=\"center\">\n<table width=\"700\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#161b22;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.4);color:#CFD8DC;\">\n \n  <!-- HEADER -->\n  <tr>\n    <td style=\"background:linear-gradient(135deg,#1a237e 0%,#0d47a1 50%,#01579b 100%);padding:30px 32px;\">\n      <table width=\"100%\"><tr>\n        <td>\n          <div style=\"font-size:10px;color:#90CAF9;text-transform:uppercase;letter-spacing:2px;margin-bottom:6px;\">Daily Briefing</div>\n          <div style=\"font-size:26px;font-weight:700;color:#ffffff;margin-bottom:4px;\">Morning Market Intelligence</div>\n          <div style=\"font-size:13px;color:#90CAF9;\">${reportDate}</div>\n        </td>\n        <td style=\"text-align:right;vertical-align:top;\">\n          <div style=\"font-size:32px;\">📊</div>\n        </td>\n      </tr></table>\n    </td>\n  </tr>\n \n  <!-- PORTFOLIO SUMMARY CARDS -->\n  <tr>\n    <td style=\"padding:24px 24px 8px;\">\n      <div style=\"color:#64B5F6;font-size:13px;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;font-weight:600;\">💰 Portfolio Overview</div>\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td style=\"padding:8px;\">\n            <div style=\"background:#1a1f2e;border:1px solid #2a2f3a;border-radius:8px;padding:14px;text-align:center;\">\n              <div style=\"color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;\">Total Value</div>\n              <div style=\"color:#E0E0E0;font-size:22px;font-weight:700;\">${formatUSD(portfolioSummary.totalCurrentValue)}</div>\n            </div>\n          </td>\n          <td style=\"padding:8px;\">\n            <div style=\"background:#1a1f2e;border:1px solid #2a2f3a;border-radius:8px;padding:14px;text-align:center;\">\n              <div style=\"color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;\">Total P&amp;L</div>\n              <div style=\"color:${totalPLColor};font-size:22px;font-weight:700;\">${formatUSD(totalPL)}</div>\n              <div style=\"color:${totalPLColor};font-size:12px;\">${formatPercent(totalPLPercent)}</div>\n            </div>\n          </td>\n          <td style=\"padding:8px;\">\n            <div style=\"background:#1a1f2e;border:1px solid #2a2f3a;border-radius:8px;padding:14px;text-align:center;\">\n              <div style=\"color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;\">Coins Tracked</div>\n              <div style=\"color:#E0E0E0;font-size:22px;font-weight:700;\">${portfolioSummary.coinCount || 0}</div>\n            </div>\n          </td>\n          <td style=\"padding:8px;\">\n            <div style=\"background:#1a1f2e;border:${(portfolioSummary.alertCount || 0) > 0 ? '1px solid #FF5252' : '1px solid #2a2f3a'};border-radius:8px;padding:14px;text-align:center;\">\n              <div style=\"color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;\">Alerts</div>\n              <div style=\"color:${(portfolioSummary.alertCount || 0) > 0 ? '#FF5252' : '#E0E0E0'};font-size:22px;font-weight:700;\">${portfolioSummary.alertCount || 0}</div>\n            </div>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n \n  <!-- CRYPTO POSITIONS TABLE -->\n  <tr>\n    <td style=\"padding:16px 24px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#1a1f2e;border-radius:8px;overflow:hidden;border:1px solid #2a2f3a;\">\n        <tr style=\"background:#0d1117;\">\n          <th style=\"padding:10px 12px;text-align:left;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">Coin</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">Price</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">24h</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">Holdings</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">Value</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">P&amp;L</th>\n          <th style=\"padding:10px 12px;text-align:right;color:#78909C;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;\">Alloc.</th>\n        </tr>\n        ${cryptoRows}\n      </table>\n    </td>\n  </tr>\n \n  <!-- BUSINESS KPI SECTION -->\n  <tr>\n    <td style=\"padding:24px 24px 8px;\">\n      <div style=\"color:#64B5F6;font-size:13px;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;font-weight:600;\">📈 Business Health Dashboard</div>\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          ${kpiCard('Revenue', rev.current, '$', rev.wowChange, rev.trend, rev.isAnomaly)}\n          ${kpiCard('Profit Margin', margin.current, '%', margin.wowChange, margin.trend, margin.isAnomaly)}\n          ${kpiCard('MRR', mrr.current, '$', mrr.wowChange, mrr.trend, mrr.isAnomaly)}\n          ${kpiCard('Churn Rate', churn.current, '%', churn.wowChange, churn.trend, churn.isAnomaly)}\n        </tr>\n        <tr>\n          ${kpiCard('Customers', customers.current, '', customers.wowChange, customers.trend, customers.isAnomaly)}\n          ${kpiCard('Cash Runway', runway.current, '', runway.wowChange, runway.trend, runway.isAnomaly)}\n          ${kpiCard('Tickets', tickets.current, '', tickets.wowChange, tickets.trend, tickets.isAnomaly)}\n          ${kpiCard('Avg Resolve', resolution.current, '', resolution.wowChange, resolution.trend, resolution.isAnomaly)}\n        </tr>\n      </table>\n    </td>\n  </tr>\n \n  <!-- ANOMALY ALERTS (if any) -->\n  ${(businessSummary.anomalyCount || 0) > 0 ? `\n  <tr>\n    <td style=\"padding:16px 24px;\">\n      <div style=\"background:#2a1015;border:1px solid #FF5252;border-radius:8px;padding:16px;\">\n        <div style=\"color:#FF5252;font-size:13px;font-weight:600;margin-bottom:8px;\">⚠️ ANOMALY ALERTS (${businessSummary.anomalyCount})</div>\n        ${(businessSummary.anomalies || []).map(a => `\n          <div style=\"color:#FFCDD2;font-size:12px;margin:4px 0;\">\n            <strong>${a.metric.replace(/_/g, ' ').toUpperCase()}</strong>: current ${a.currentValue} is ${a.direction} (expected range: ${a.expectedRange}, z-score: ${a.zScore})\n          </div>\n        `).join('')}\n      </div>\n    </td>\n  </tr>\n  ` : ''}\n \n  <!-- AI ANALYSIS -->\n  <tr>\n    <td style=\"padding:24px;\">\n      <div style=\"color:#64B5F6;font-size:13px;text-transform:uppercase;letter-spacing:1px;margin-bottom:12px;font-weight:600;\">🤖 AI Analysis</div>\n      <div style=\"background:#1a1f2e;border:1px solid #2a2f3a;border-radius:8px;padding:20px;\">\n        <p style=\"margin:12px 0;line-height:1.6;color:#CFD8DC;font-size:13px;\">\n          ${formattedAnalysis}\n        </p>\n      </div>\n    </td>\n  </tr>\n \n  <!-- FOOTER -->\n  <tr>\n    <td style=\"padding:20px 24px;border-top:1px solid #2a2f3a;\">\n      <table width=\"100%\"><tr>\n        <td style=\"color:#546E7A;font-size:11px;\">\n          Morning Market Intelligence · Generated by n8n + Claude AI<br>\n          Crypto data: CoinGecko API · Business data: Google Sheets<br>\n          <em style=\"color:#546E7A;\">This is an automated report with simulated data. Not financial advice.</em>\n        </td>\n        <td style=\"text-align:right;color:#546E7A;font-size:11px;\">\n          ${new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}\n        </td>\n      </tr></table>\n    </td>\n  </tr>\n \n</table>\n</td></tr></table>\n</body>\n</html>\n`;\n \nreturn [{\n  json: {\n    emailHtml: html,\n    emailSubject: `📊 Morning Market Intelligence — ${reportDate}`,\n    aiAnalysis: aiAnalysis\n  }\n}];"
